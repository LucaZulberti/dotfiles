use-grammars = { only = ["d2"] }

[language-server.efm]
command = "efm-langserver"
args = ["-c", "{{ .chezmoi.homeDir }}/.config/efm-langserver/config.yaml"]
config = { documentFormatting = true }

[[language]]
name = "python"
auto-format = true

[[language]]
name = "bash"
formatter = { command = "shfmt", args = ["-i", "2"] }
auto-format = true

[[language]]
name = "git-commit"
rulers = [100, 100]
text-width = 100
soft-wrap = { enable = true, wrap-at-text-width = true }

[[language]]
name = "markdown"
formatter = { command = "mdformat", args = ["-"] }
auto-format = true
text-width = 100
rulers = [100]

[[language]]
name = "cmake"
formatter = { command = "cmake-format", args = ["-"] }
auto-format = true

[[language]]
name = "vhdl"
persistent-diagnostic-sources = ["vsg"]
language-servers = [
  { name = "efm", only-features = ["diagnostics", "format"] },
  { name = "vhdl_ls", except-features = ["format"] },
]
auto-format = true
text-width = 100
rulers = [100]

[[language]]
name = "yaml"
auto-format = true
formatter = { command = "prettier", args = ["--stdin-filepath", "%{buffer_name}"] }

[[language]]
name = "typescript"
language-servers = [
  { name = "typescript-language-server", except-features = ["format"] },
  { name = "angular", except-features = ["format"] },
]
formatter = { command = "prettier", args = ["--stdin-filepath", "%{buffer_name}"] }
auto-format = true

[[language]]
name = "html"
language-servers = [
  { name = "vscode-html-language-server", except-features = ["format"] },
  { name = "angular", except-features = ["format"] },
]
formatter = { command = "prettier", args = ["--stdin-filepath", "%{buffer_name}"] }
auto-format = true

[[language]]
name = "css"
formatter = { command = "prettier", args = ["--stdin-filepath", "%{buffer_name}"] }
auto-format = true

[[language]]
name = "scss"
formatter = { command = "prettier", args = ["--stdin-filepath", "%{buffer_name}"] }
auto-format = true

[[language]]
name = "json"
formatter = { command = "prettier", args = ["--stdin-filepath", "%{buffer_name}"] }
auto-format = true

[[language]]
name = "typst"
auto-format = true
formatter.command = "typstyle"

[[language]]
name = "d2"
language-id = "d2"
scope = "source.d2"
injection-regex = "d2"
file-types = ["d2"]
comment-token = "#"
indent = { tab-width = 2, unit = "  " }
grammar = "d2"
language-servers = [{ name = "efm", only-features = ["format"] }]
auto-format = true

[[grammar]]
name = "d2"
source = { git = "https://github.com/ravsii/tree-sitter-d2", rev = "main" }
